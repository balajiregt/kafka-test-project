### Health
GET http://localhost:8080/actuator/health

### Register user
POST http://localhost:8080/api/accounts/users
Content-Type: application/json

{
  "email": "anika.rao@example.com",
  "displayName": "Anika Rao",
  "department": "Finance",
  "jobTitle": "Controller"
}

### Activate user
POST http://localhost:8080/api/accounts/users/REPLACE_WITH_USER_ID/status
Content-Type: application/json

{
  "status": "ACTIVE",
  "reason": "HR onboarding completed"
}

### Update user profile
POST http://localhost:8080/api/accounts/users/REPLACE_WITH_USER_ID/profile
Content-Type: application/json

{
  "displayName": "Anika Rao",
  "department": "Finance Operations",
  "jobTitle": "Senior Controller"
}

### Register credential reference for sign-in
POST http://localhost:8080/api/accounts/credentials
Content-Type: application/json

{
  "userId": "REPLACE_WITH_USER_ID",
  "credentialType": "PASSWORD_HASH",
  "credentialReference": "password-hash:v1:anika",
  "mfaEnabled": true
}

### Sign in
POST http://localhost:8080/api/accounts/sign-ins
Content-Type: application/json

{
  "email": "anika.rao@example.com",
  "credentialReference": "password-hash:v1:anika"
}

### Request password reset
POST http://localhost:8080/api/accounts/password-reset-requests
Content-Type: application/json

{
  "email": "anika.rao@example.com"
}

### Complete password reset
POST http://localhost:8080/api/accounts/password-resets/complete
Content-Type: application/json

{
  "resetRequestId": "REPLACE_WITH_RESET_REQUEST_ID",
  "newCredentialReference": "password-hash:v2:anika",
  "mfaEnabled": true
}

### Query users
GET http://localhost:8080/api/accounts/users

### Query user credentials
GET http://localhost:8080/api/accounts/users/REPLACE_WITH_USER_ID/credentials

### Query user sign-in attempts
GET http://localhost:8080/api/accounts/users/REPLACE_WITH_USER_ID/sign-in-attempts

### Query user password reset requests
GET http://localhost:8080/api/accounts/users/REPLACE_WITH_USER_ID/password-reset-requests

### Query tracked consumed events
GET http://localhost:8080/api/accounts/tracked-events

### Account assurance journey graph for a user
GET http://localhost:8080/api/assurance/subjects/REPLACE_WITH_USER_ID/journey

### Account assurance advisor findings for a user
GET http://localhost:8080/api/assurance/subjects/REPLACE_WITH_USER_ID/findings

### Testing recommendations by layer
GET http://localhost:8080/api/assurance/testing-recommendations

### Evidence playground - sequence gap
# Requires app.assurance.playground.enabled=true
POST http://localhost:8080/api/assurance/playground/evidence
Content-Type: application/json

{
  "scenarioName": "sequence-gap",
  "subjectId": "10000000-0000-0000-0000-000000000101",
  "events": [
    {
      "eventType": "USER_REGISTERED",
      "aggregateType": "USER",
      "aggregateId": "10000000-0000-0000-0000-000000000101",
      "subjectId": "10000000-0000-0000-0000-000000000101",
      "correlationId": "corr-sequence-001",
      "topicName": "playground.assurance.events.v1",
      "partitionNumber": 0,
      "offsetNumber": 0,
      "schemaVersion": 1,
      "data": {"status": "ACTIVE"}
    },
    {
      "eventType": "SIGN_IN_SUCCEEDED",
      "aggregateType": "SIGN_IN_ATTEMPT",
      "aggregateId": "10000000-0000-0000-0000-000000000102",
      "subjectId": "10000000-0000-0000-0000-000000000101",
      "correlationId": "corr-sequence-002",
      "topicName": "playground.assurance.events.v1",
      "partitionNumber": 0,
      "offsetNumber": 1,
      "schemaVersion": 1,
      "data": {"result": "SUCCESS"}
    }
  ]
}

### Evidence playground - metadata gap
# Requires app.assurance.playground.enabled=true
POST http://localhost:8080/api/assurance/playground/evidence
Content-Type: application/json

{
  "scenarioName": "metadata-gap",
  "subjectId": "20000000-0000-0000-0000-000000000201",
  "events": [
    {
      "eventType": "USER_REGISTERED",
      "aggregateType": "USER",
      "subjectId": "20000000-0000-0000-0000-000000000201",
      "topicName": "playground.assurance.events.v1",
      "partitionNumber": 0,
      "data": {"status": "PENDING_ACTIVATION"}
    }
  ]
}

### Assurance config assistant - local deterministic template
POST http://localhost:8080/api/assurance/config-assistant
Content-Type: application/json

{
  "message": "Create assurance YAML for these Kafka events and classify the test layers.",
  "contextSources": [
    {
      "sourceType": "asyncapi",
      "name": "account-events",
      "content": "USER_REGISTERED -> USER_STATUS_CHANGED -> CREDENTIAL_REGISTERED -> SIGN_IN_SUCCEEDED. Required metadata: eventType, aggregateId, subjectId, correlationId, schemaVersion, offsetNumber."
    }
  ]
}

### Assurance config assistant - BYOK mode
POST http://localhost:8080/api/assurance/config-assistant
Content-Type: application/json

{
  "message": "Review this assurance YAML and suggest missing rules.",
  "model": "REPLACE_WITH_MODEL",
  "apiKey": "REPLACE_WITH_API_KEY",
  "baseUrl": "https://api.openai.com/v1",
  "contextSources": [
    {
      "sourceType": "openapi",
      "name": "commands-openapi",
      "content": "Paste OpenAPI, AsyncAPI, schema, workflow, or sample payload context here."
    }
  ]
}

### Account assurance report UI
GET http://localhost:8080/assurance-report.html?subjectId=REPLACE_WITH_USER_ID
